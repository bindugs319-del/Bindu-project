# Don't ship local dev artifacts or secrets into the Docker image
venv/
__pycache__/
*.pyc
.pytest_cache/
.flake8
*.dump
uploads/*
!uploads/.gitkeep
.env
.env.*
!.envexample
*.md
credentials/

# Extra safety net for the recursive `COPY . .` in the Dockerfile — these
# patterns catch common places secrets/keys end up even if someone adds a
# new one later without remembering to update this file explicitly above.
.git/
*.pem
*.key
*.p12
id_rsa*
*.log
